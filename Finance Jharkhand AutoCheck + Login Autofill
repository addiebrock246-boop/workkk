// ==UserScript==
// @name         Finance Jharkhand - CAPTCHA Refresh Password FIX (Ultimate)
// @namespace    http://tampermonkey.net/
// @version      5.0
// @description  Password ko refresh पर हटने से बचाओ — पक्का समाधान
// @match        https://finance.jharkhand.gov.in/jegras/DepartmentLogin.aspx*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    const USERNAME = "rishavsingh20068@gmail.com";
    const PASSWORD = "Rishu@123";

    // ============================================
    // 🔥 पासवर्ड को "अमर" बनाओ — हर 200ms चेक करो
    // ============================================
    function keepPasswordAlive() {
        const passField = document.querySelector("#txtPassword");
        const userField = document.querySelector("#txtLoginId");

        // अगर फील्ड्स नहीं मिलीं, तो रुको
        if (!passField || !userField) return;

        // अगर यूजरनेम खाली है, तो भरो
        if (!userField.value) {
            userField.value = USERNAME;
            userField.dispatchEvent(new Event('input', { bubbles: true }));
        }

        // 🔥 अगर पासवर्ड खाली है, तो तुरंत भरो
        if (!passField.value) {
            passField.value = PASSWORD;
            passField.dispatchEvent(new Event('input', { bubbles: true }));
            passField.dispatchEvent(new Event('change', { bubbles: true }));
            console.log("✅ Password restored after being cleared!");
        }
    }

    // पहली बार भरो (जब पेज लोड हो)
    function initialFill() {
        const userField = document.querySelector("#txtLoginId");
        const passField = document.querySelector("#txtPassword");

        if (userField && !userField.value) {
            userField.value = USERNAME;
            userField.dispatchEvent(new Event('input', { bubbles: true }));
        }
        if (passField && !passField.value) {
            passField.value = PASSWORD;
            passField.dispatchEvent(new Event('input', { bubbles: true }));
        }
    }

    // ============================================
    // 🛡️ पेज लोड होने पर शुरू करो
    // ============================================
    if (document.readyState === 'complete') {
        setTimeout(() => {
            initialFill();
            // हर 200ms में चेक करो
            setInterval(keepPasswordAlive, 200);
            console.log("🚀 Password Keeper started — password will never be lost!");
        }, 1000);
    } else {
        window.addEventListener('load', function() {
            setTimeout(() => {
                initialFill();
                setInterval(keepPasswordAlive, 200);
                console.log("🚀 Password Keeper started — password will never be lost!");
            }, 1000);
        });
    }

    // ============================================
    // 🧩 अगर पेज में कोई बदलाव हो (जैसे CAPTCHA Refresh)
    // ============================================
    const observer = new MutationObserver(() => {
        // बस एक बार चेक कर लो
        keepPasswordAlive();
    });
    observer.observe(document.body, {
        childList: true,
        subtree: true
    });

})();
